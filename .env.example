# PrediBeat local runtime configuration
APP_NAME=PrediBeat V3 Structured Chatbot
APP_ENV=development
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Jakarta
WEB_PORT=8000

# PostgreSQL Docker
POSTGRES_DB=predibeat
POSTGRES_USER=predibeat
POSTGRES_PASSWORD=ganti-password-kuat

# Model lokal melalui Ollama / SSH tunnel
OLLAMA_BASE_URL=http://host.docker.internal:11435
OLLAMA_TIMEOUT_SECONDS=300
EMBEDDING_MODEL=bge-m3
QA_MODEL=llama3.1:8b
VISION_MODEL=llava

# Qdrant. Bisa lokal atau server terpisah. API key boleh kosong untuk Qdrant lokal.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
VECTOR_SIZE=1024
QDRANT_PDF_CHUNKS_COLLECTION=predibeat_pdf_chunks
QDRANT_PDF_QA_COLLECTION=predibeat_pdf_qa
QDRANT_FOOD_COLLECTION=predibeat_food_chunks

# Worker dan chunking
RAG_PROCESS_MODE=worker
RAG_DELETE_SOURCE_AFTER_INDEX=false
WORKER_POLL_SECONDS=5
PDF_CHUNK_MAX_TOKENS=900
PDF_CHUNK_OVERLAP_TOKENS=100
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_COMMAND=mineru
MINERU_FALLBACK_PYPDF=true

# Dataset referensi
FOOD_DATASET_PATH=/app/data/reference/food/master_makanan_kategori_flag_mealplan.csv
DIET_DATASET_PATH=/app/data/reference/diets/NutrinusaDatabase_InformationDiet.csv
ACTIVITY_DATASET_PATH=/app/data/reference/activities.csv
DATASET_BACKUP_DIR=/app/data/reference/backups

# Autentikasi web
AUTH_SECRET_KEY=ganti-dengan-random-secret-minimal-32-karakter
AUTH_COOKIE_NAME=predibeat_session
AUTH_SESSION_MINUTES=720
AUTH_COOKIE_SECURE=false

# Sumber migrasi manual user V1, opsional
V1_DATABASE_URL=
